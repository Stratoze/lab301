# ===== MySQL =====
DB_ROOT_PASSWORD=
DB_DATABASE=lottery_db
DB_USERNAME=lottery
DB_PASSWORD=

# ===== Backend (Spring Boot picks these up as OS env vars) =====
DB_URL=jdbc:mysql://db:3306/lottery_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
JWT_SECRET=
JWT_EXPIRATION=86400000
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
SERVER_PORT=8080

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Social
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# App
FRONTEND_BASE_URL=http://localhost:5173

# ===== Frontend build args =====
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
