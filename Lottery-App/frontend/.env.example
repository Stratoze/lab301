# VITE_API_BASE_URL is optional, defaults to /api/v1 (Vite proxy handles it in dev)
# Set this to your full backend URL when deploying without the Vite proxy
# VITE_API_BASE_URL=http://localhost:8080/api/v1
# Google OAuth Client ID (from console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=
# Facebook App ID (from developers.facebook.com)
VITE_FACEBOOK_APP_ID=